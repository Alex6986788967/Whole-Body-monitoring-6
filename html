<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>VitalEdge · Terminal</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=JetBrains+Mono:wght@300;400;500;700&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;overflow:hidden;background:#060810}
body{font-family:'JetBrains Mono','Fira Code',monospace;font-size:13px;color:#c9d1d9}

/* ── OS SHELL ── */
.shell{width:100vw;height:100vh;display:flex;flex-direction:column}

/* ── MENU BAR ── */
.menubar{height:26px;background:#161925;border-bottom:1px solid #1e2538;display:flex;align-items:center;padding:0 14px;gap:18px;flex-shrink:0;font-size:11px;color:#6b7a96;user-select:none}
.menubar .brand{font-family:'Bebas Neue',Impact,sans-serif;font-size:1.05rem;letter-spacing:.1em;color:#00d9b8;margin-right:6px}
.menubar .brand em{color:#c9d1d9;font-style:normal}
.mi{cursor:pointer;padding:2px 6px;border-radius:3px;transition:background .12s}
.mi:hover{background:rgba(255,255,255,.08);color:#e2e8f0}
.mright{margin-left:auto;display:flex;gap:12px;align-items:center}
.mclock{font-size:11px;color:#6b7a96}
.mbadge{font-size:10px;letter-spacing:.08em;padding:1px 8px;border-radius:10px;background:rgba(0,217,184,.1);color:#00d9b8;border:1px solid rgba(0,217,184,.2)}

/* ── WINDOW ── */
.window{flex:1;display:flex;flex-direction:column;margin:6px;border-radius:10px;overflow:hidden;box-shadow:0 28px 90px rgba(0,0,0,.85),0 0 0 1px rgba(255,255,255,.06);min-height:0}

/* ── TITLE BAR ── */
.titlebar{height:38px;background:#181d2e;border-bottom:1px solid #242b3d;display:flex;align-items:center;padding:0 14px;gap:10px;flex-shrink:0;user-select:none}
.tl-lights{display:flex;gap:7px}
.tl{width:12px;height:12px;border-radius:50%;cursor:pointer;transition:filter .15s}
.tl:hover{filter:brightness(1.25)}
.tl.r{background:#ff5f57}.tl.y{background:#febc2e}.tl.g{background:#28c840}
.tl-title{flex:1;text-align:center;font-size:11.5px;color:#6b7a96;letter-spacing:.03em}
.tl-title strong{color:#c9d1d9}
.tl-btns{display:flex;gap:5px}
.tl-btn{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.08em;text-transform:uppercase;padding:3px 10px;border-radius:5px;border:1px solid #242b3d;background:transparent;color:#6b7a96;cursor:pointer;transition:all .15s}
.tl-btn:hover{color:#00d9b8;border-color:rgba(0,217,184,.4)}
.tl-btn.act{background:rgba(0,217,184,.1);color:#00d9b8;border-color:rgba(0,217,184,.4)}

/* ── TAB BAR ── */
.tabbar{height:36px;background:#12172A;border-bottom:1px solid #1a2035;display:flex;align-items:flex-end;padding:0 12px 0;gap:1px;flex-shrink:0;overflow-x:auto}
.tabbar::-webkit-scrollbar{display:none}
.etab{display:flex;align-items:center;gap:6px;padding:5px 13px;border-radius:6px 6px 0 0;font-size:11px;color:#6b7a96;cursor:pointer;border:1px solid transparent;border-bottom:none;white-space:nowrap;transition:all .15s;position:relative;top:1px;user-select:none}
.etab:hover{background:rgba(255,255,255,.04);color:#c9d1d9}
.etab.active{background:#0d1120;color:#e2e8f0;border-color:#1a2035;border-bottom-color:#0d1120}
.etab .tdot{width:7px;height:7px;border-radius:50%;flex-shrink:0}
.etab .tx{margin-left:3px;font-size:10px;opacity:0;transition:opacity .1s}
.etab:hover .tx,.etab.active .tx{opacity:.6}

/* ── EDITOR BODY ── */
.ebody{flex:1;display:flex;min-height:0;background:#0d1120}

/* ── SIDEBAR ── */
.sidebar{width:210px;flex-shrink:0;background:#0e1423;border-right:1px solid #1a2035;display:flex;flex-direction:column;overflow:hidden}
.sb-hdr{font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:#3d4d63;padding:10px 14px 5px;user-select:none}
.sb-tree{flex:1;overflow-y:auto;padding:3px 0 8px}
.sb-tree::-webkit-scrollbar{width:3px}
.sb-tree::-webkit-scrollbar-thumb{background:#1e2740;border-radius:2px}
.sb-row{display:flex;align-items:center;gap:7px;padding:4px 14px;font-size:11.5px;cursor:pointer;color:#6b7a96;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;transition:all .12s;border-left:2px solid transparent;user-select:none}
.sb-row:hover{background:rgba(255,255,255,.04);color:#c9d1d9}
.sb-row.active{background:rgba(0,217,184,.06);color:#e2e8f0;border-left-color:#00d9b8}
.sb-row .ic{font-size:11px;flex-shrink:0;width:16px;text-align:center}
.sb-row .lc{margin-left:auto;font-size:10px;color:#3d4d63;flex-shrink:0}
.sb-sep{font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:#3d4d63;padding:8px 14px 3px;user-select:none}

/* ── CODE PANE ── */
.cpane{flex:1;display:flex;flex-direction:column;min-width:0;overflow:hidden}
.crumb{height:28px;background:#0d1120;border-bottom:1px solid #141c2c;display:flex;align-items:center;padding:0 18px;gap:6px;font-size:11px;color:#3d4d63;flex-shrink:0;user-select:none}
.crumb .ca{color:#8892a4}
.csep{color:#1e2740}

/* ── LINE NUMBERS + CODE ── */
.ceditor{flex:1;display:flex;min-height:0;overflow:hidden}
.lnums{width:50px;flex-shrink:0;background:#0d1120;padding:14px 0;text-align:right;font-size:12.5px;line-height:1.72;color:#2d3a4f;user-select:none;overflow:hidden;border-right:1px solid #141c2c}
.lnums span{display:block;padding-right:10px;height:1.72em;cursor:pointer;transition:color .1s}
.lnums span:hover{color:#6b7a96}
.lnums span.hl{color:#00d9b8;background:rgba(0,217,184,.06)}
.cscroll{flex:1;overflow:auto;padding:14px 0 14px 18px;min-width:0}
.cscroll::-webkit-scrollbar{width:8px;height:8px}
.cscroll::-webkit-scrollbar-track{background:#080c18}
.cscroll::-webkit-scrollbar-thumb{background:#1a2338;border-radius:4px}
.cscroll::-webkit-scrollbar-thumb:hover{background:#253047}
pre{font-family:'JetBrains Mono','Fira Code',monospace;font-size:13px;line-height:1.72;color:#c9d1d9;white-space:pre;tab-size:2;min-width:max-content}

/* ── MINIMAP ── */
.mmap{width:72px;flex-shrink:0;background:#09101e;border-left:1px solid #141c2c;overflow:hidden;position:relative;cursor:pointer}
.mmap-vp{position:absolute;left:0;right:0;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.07);pointer-events:none;transition:top .05s}
.mmap-canvas{padding:3px 3px;pointer-events:none}
.mml{height:2px;margin-bottom:1.1px;border-radius:1px;background:#1e2740;max-width:68px}

/* ── SYNTAX ── */
.k{color:#c792ea}
.fn{color:#82aaff}
.s{color:#c3e88d}
.cm{color:#4a5e70;font-style:italic}
.n{color:#f78c6c}
.op{color:#89ddff}
.jt{color:#f07178}
.pr{color:#89ddff}
.co{color:#00d9b8}
.bo{color:#ffcb6b}

/* ── STATUS BAR ── */
.statusbar{height:22px;background:#00d9b8;display:flex;align-items:center;padding:0 14px;gap:16px;font-size:10.5px;color:#07090f;font-weight:600;flex-shrink:0;letter-spacing:.03em;user-select:none}
.sbr{margin-left:auto;display:flex;gap:14px}
.sbsep{opacity:.35}

/* ── TERMINAL ── */
.terminal{height:190px;flex-shrink:0;border-top:1px solid #1a2035;display:flex;flex-direction:column;background:#080c18}
.termtabs{height:28px;background:#0e1423;border-bottom:1px solid #1a2035;display:flex;align-items:center;padding:0 10px;gap:3px;flex-shrink:0}
.ttab{font-size:11px;padding:3px 12px;border-radius:4px 4px 0 0;cursor:pointer;color:#6b7a96;transition:all .12s;border:1px solid transparent;border-bottom:none;user-select:none}
.ttab.active{background:#080c18;color:#c9d1d9;border-color:#1a2035}
.tact{margin-left:auto;display:flex;gap:6px}
.tbtn{font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:.08em;text-transform:uppercase;padding:2px 9px;border-radius:4px;border:1px solid #1e2740;background:transparent;color:#6b7a96;cursor:pointer;transition:all .15s}
.tbtn:hover{color:#00d9b8;border-color:rgba(0,217,184,.4)}
.tscroll{flex:1;overflow-y:auto;padding:8px 14px;font-size:12px;line-height:1.65}
.tscroll::-webkit-scrollbar{width:3px}
.tscroll::-webkit-scrollbar-thumb{background:#1e2740;border-radius:2px}
.trow{display:flex;align-items:flex-start;gap:7px;margin-bottom:1px}
.tp{color:#00d9b8;flex-shrink:0;user-select:none}
.tc{color:#c3e88d}
.to{color:#6b7a96}
.to.ok{color:#00d9b8}.to.warn{color:#f59e0b}.to.err{color:#f43f5e}.to.dim{color:#3d4d63}
.cursor{display:inline-block;width:7px;height:12px;background:#00d9b8;animation:blink 1s step-end infinite;vertical-align:text-bottom;margin-left:1px}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0}}

/* ── TOAST ── */
.toast{position:fixed;bottom:36px;right:20px;background:#00d9b8;color:#07090f;font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:7px 16px;border-radius:7px;opacity:0;transition:opacity .2s;pointer-events:none;z-index:9999}
.toast.show{opacity:1}
</style>
</head>
<body>
<div class="shell">

  <!-- MENU BAR -->
  <div class="menubar">
    <span class="brand">Vital<em>Edge</em></span>
    <span class="mi">File</span><span class="mi">Edit</span>
    <span class="mi">View</span><span class="mi">Terminal</span>
    <span class="mi">Help</span>
    <div class="mright">
      <span class="mbadge">Galaxy Watch 8</span>
      <span class="mclock" id="mclock">--:--</span>
    </div>
  </div>

  <!-- WINDOW -->
  <div class="window">

    <!-- TITLE BAR -->
    <div class="titlebar">
      <div class="tl-lights">
        <div class="tl r"></div>
        <div class="tl y"></div>
        <div class="tl g"></div>
      </div>
      <div class="tl-title"><strong id="tl-fname">App.jsx</strong> — VitalEdge Galaxy Watch Dashboard</div>
      <div class="tl-btns">
        <button class="tl-btn act" id="btn-full" onclick="showFull()">Full File</button>
        <button class="tl-btn" id="btn-copy" onclick="copyAll()">Copy All</button>
        <button class="tl-btn" onclick="runCmd('run')">▶ Run</button>
      </div>
    </div>

    <!-- TAB BAR -->
    <div class="tabbar" id="tabbar"></div>

    <!-- EDITOR BODY -->
    <div class="ebody">

      <!-- SIDEBAR -->
      <div class="sidebar">
        <div class="sb-hdr">Explorer</div>
        <div class="sb-tree" id="sbtree"></div>
      </div>

      <!-- CODE PANE -->
      <div class="cpane">
        <div class="crumb">
          <span>vitaledge</span><span class="csep">›</span>
          <span>src</span><span class="csep">›</span>
          <span class="ca" id="crumb-file">App.jsx</span>
          <span style="margin-left:auto;color:#3d4d63;font-size:10px" id="crumb-range">lines 1–877</span>
        </div>
        <div class="ceditor">
          <div class="lnums" id="lnums"></div>
          <div class="cscroll" id="cscroll" onscroll="onScroll()">
            <pre id="cblock"></pre>
          </div>
          <div class="mmap" id="mmap" onclick="mmapClick(event)">
            <div class="mmap-vp" id="mmvp" style="top:0;height:40px"></div>
            <div class="mmap-canvas" id="mmcanvas"></div>
          </div>
        </div>
      </div>

    </div><!-- ebody -->

    <!-- STATUS BAR -->
    <div class="statusbar">
      <span>⎇&nbsp;main</span>
      <span class="sbsep">|</span>
      <span id="sb-section">Full File</span>
      <span class="sbsep">|</span>
      <span>JavaScript React</span>
      <div class="sbr">
        <span id="sb-lines">877 lines</span>
        <span class="sbsep">|</span>
        <span id="sb-cursor">Ln 1, Col 1</span>
        <span class="sbsep">|</span>
        <span>UTF-8</span>
      </div>
    </div>

    <!-- TERMINAL -->
    <div class="terminal">
      <div class="termtabs">
        <div class="ttab active">bash</div>
        <div class="ttab" style="color:#3d4d63">OUTPUT</div>
        <div class="tact">
          <button class="tbtn" onclick="runCmd('install')">npm install</button>
          <button class="tbtn" onclick="runCmd('run')">npm run dev</button>
          <button class="tbtn" onclick="runCmd('build')">npm run build</button>
          <button class="tbtn" onclick="runCmd('git')">git push</button>
          <button class="tbtn" onclick="clearTerm()">clear</button>
        </div>
      </div>
      <div class="tscroll" id="tscroll"></div>
    </div>

  </div><!-- window -->
</div><!-- shell -->

<div class="toast" id="toast">Copied to clipboard!</div>

<script>
// ══════════════════════════════════════════════
//  DATA  — full code + 8 sections embedded
// ══════════════════════════════════════════════
const DATA = {"full":"import { useState, useCallback, useRef, useEffect } from \"react\";\n\n// ═══════════════════════════════════════════════════════════════\n//  GALAXY WATCH CSV PARSER\n//  Handles Samsung Health export format from Galaxy Watch 8\n// ═══════════════════════════════════════════════════════════════\n\nfunction parseCSV(text) {\n  const lines = text.trim().split(/\\r?\\n/);\n  if (lines.length < 2) return [];\n  const headers = lines[0].split(\",\").map(h => h.trim().replace(/^\"|\"$/g, \"\").toLowerCase());\n  return lines.slice(1).map(line => {\n    const vals = line.match(/(\".*?\"|[^,]+|(?<=,)(?=,)|(?<=,)$|^(?=,))/g) || [];\n    const row = {};\n    headers.forEach((h, i) => {\n      row[h] = (vals[i] || \"\").replace(/^\"|\"$/g, \"\").trim();\n    });\n    return row;\n  });\n}\n\nfunction detectMetricType(filename, headers) {\n  const f = filename.toLowerCase();\n  const h = headers.join(\" \").toLowerCase();\n  if (f.includes(\"step\") || h.includes(\"step_count\")) return \"steps\";\n  if (f.includes(\"calorie\") || h.includes(\"calorie\")) return \"calories\";\n  if (f.includes(\"exercise\") || f.includes(\"active\") || h.includes(\"active_time\")) return \"activeMinutes\";\n  if (f.includes(\"heart\") || f.includes(\"hr\") || h.includes(\"heart_rate\")) return \"heartRate\";\n  if (f.includes(\"ecg\") || h.includes(\"ecg\")) return \"ecg\";\n  if (f.includes(\"oxygen\") || f.includes(\"spo2\") || h.includes(\"spo2\")) return \"spO2\";\n  if (f.includes(\"sleep\") || h.includes(\"sleep\")) return \"sleep\";\n  if (f.includes(\"stress\") || h.includes(\"stress\")) return \"stress\";\n  if (f.includes(\"body\") || f.includes(\"composition\") || h.includes(\"body_fat\")) return \"bodyComposition\";\n  if (f.includes(\"blood_pressure\") || f.includes(\"bp\") || h.includes(\"systolic\")) return \"bloodPressure\";\n  if (f.includes(\"menstrual\") || f.includes(\"cycle\") || h.includes(\"cycle_phase\")) return \"menstrual\";\n  if (f.includes(\"fall\") || h.includes(\"fall\")) return \"fallDetection\";\n  if (f.includes(\"apnea\") || h.includes(\"ahi\")) return \"sleepApnea\";\n  if (f.includes(\"antioxidant\") || f.includes(\"carotenoid\") || h.includes(\"carotenoid\")) return \"antioxidant\";\n  if (f.includes(\"energy\") || h.includes(\"energy_score\")) return \"energyScore\";\n  return \"unknown\";\n}\n\nfunction extractMetricValue(rows, type) {\n  if (!rows.length) return null;\n  const latest = rows[rows.length - 1];\n  switch (type) {\n    case \"steps\": {\n      const val = parseFloat(latest.step_count || latest.steps || latest.count || 0);\n      const weekly = rows.slice(-7).map(r => parseFloat(r.step_count || r.steps || 0));\n      return { value: val, goal: 15000, unit: \"steps\", trend: calcTrend(rows, \"step_count\"), weekly };\n    }\n    case \"calories\": {\n      const val = parseFloat(latest.calorie || latest.calories || latest.active_calorie || 0);\n      return { value: val, goal: 3200, unit: \"kcal\", trend: calcTrend(rows, \"calorie\"), weekly: rows.slice(-7).map(r => parseFloat(r.calorie || r.calories || 0)) };\n    }\n    case \"activeMinutes\": {\n      const val = parseFloat(latest.active_time || latest.duration || latest.active_minutes || 0);\n      return { value: Math.round(val / 60) || val, goal: 90, unit: \"min\", trend: calcTrend(rows, \"active_time\"), weekly: rows.slice(-7).map(r => Math.round(parseFloat(r.active_time || r.duration || 0) / 60)) };\n    }\n    case \"heartRate\": {\n      const resting = parseFloat(latest.heart_rate || latest.resting_hr || latest.min || 58);\n      const max = parseFloat(latest.max || latest.peak_hr || 174);\n      const hrv = parseFloat(latest.hrv || latest.heart_rate_variability || 62);\n      return { resting, max, hrv, unit: \"bpm\", trend: calcTrend(rows, \"heart_rate\"), weekly: rows.slice(-7).map(r => parseFloat(r.heart_rate || r.resting_hr || 0)) };\n    }\n    case \"spO2\": {\n      const val = parseFloat(latest.spo2 || latest.oxygen_saturation || latest.value || 98);\n      return { value: val, unit: \"%\", trend: \"Stable\", low: 95 };\n    }\n    case \"stress\": {\n      const val = parseFloat(latest.stress_score || latest.stress || latest.value || 32);\n      return { value: val, unit: \"/ 100\", label: val < 40 ? \"Low\" : val < 70 ? \"Medium\" : \"High\", trend: calcTrend(rows, \"stress_score\") };\n    }\n    case \"sleep\": {\n      const total = parseFloat(latest.total || latest.sleep_duration || 7.9);\n      const deep = parseFloat(latest.deep || latest.deep_sleep || 1.7);\n      const rem = parseFloat(latest.rem || latest.rem_sleep || 1.9);\n      const light = total - deep - rem;\n      return {\n        total: `${Math.floor(total)}h ${Math.round((total % 1) * 60)}m`,\n        bedtime: latest.start_time || \"22:41\",\n        wakeup: latest.end_time || \"06:35\",\n        stages: {\n          deep:  { duration: `${Math.floor(deep)}h ${Math.round((deep%1)*60)}m`, pct: Math.round(deep/total*100), color: \"#2563eb\" },\n          light: { duration: `${Math.floor(Math.max(0,light))}h ${Math.round((Math.max(0,light)%1)*60)}m`, pct: Math.round(Math.max(0,light)/total*100), color: \"#60a5fa\" },\n          rem:   { duration: `${Math.floor(rem)}h ${Math.round((rem%1)*60)}m`, pct: Math.round(rem/total*100), color: \"#a78bfa\" },\n          awake: { duration: \"0h 27m\", pct: Math.max(0, 100 - Math.round(deep/total*100) - Math.round(Math.max(0,light)/total*100) - Math.round(rem/total*100)), color: \"#374151\" },\n        },\n        trend: \"+18 min vs avg\"\n      };\n    }\n    case \"bloodPressure\": {\n      const sys = parseFloat(latest.systolic || latest.blood_pressure_systolic || 118);\n      const dia = parseFloat(latest.diastolic || latest.blood_pressure_diastolic || 76);\n      return { systolic: sys, diastolic: dia, unit: \"mmHg\", status: sys < 120 ? \"Optimal\" : sys < 130 ? \"Normal\" : \"Elevated\" };\n    }\n    case \"bodyComposition\": {\n      return {\n        weight: parseFloat(latest.weight || latest.body_weight || 82.4),\n        bodyFat: parseFloat(latest.body_fat || latest.fat_percentage || 14.2),\n        muscleMass: parseFloat(latest.muscle_mass || latest.skeletal_muscle || 68.4),\n        boneMass: parseFloat(latest.bone_mass || 3.1),\n        water: parseFloat(latest.body_water || latest.water_percentage || 62.5),\n        bmi: parseFloat(latest.bmi || 22.8),\n        trend: \"+0.3 kg muscle this month\"\n      };\n    }\n    case \"ecg\": {\n      return {\n        rhythm: latest.rhythm || \"Normal Sinus Rhythm\",\n        rate: latest.rate || `${latest.heart_rate || 58} bpm`,\n        qt: latest.qt_interval || \"382 ms\",\n        pr: latest.pr_interval || \"156 ms\",\n        qrs: latest.qrs_duration || \"88 ms\",\n        notes: latest.notes || \"Athlete bradycardia noted. No abnormalities detected.\",\n        tags: [\"NSR\", \"No abnormalities\", \"QT normal\"]\n      };\n    }\n    case \"menstrual\": {\n      const day = parseInt(latest.cycle_day || latest.day || 12);\n      const length = parseInt(latest.cycle_length || latest.length || 28);\n      const phase = latest.cycle_phase || latest.phase || \"Follicular\";\n      return { day, length, phase, next: `~${length - day} days`, note: \"Estrogen rising — high-intensity window.\" };\n    }\n    case \"sleepApnea\": {\n      const ahi = parseFloat(latest.ahi || latest.apnea_hypopnea_index || 4.1);\n      return { ahi, status: ahi < 5 ? \"Normal\" : ahi < 15 ? \"Mild\" : ahi < 30 ? \"Moderate\" : \"Severe\", events: parseInt(latest.events || 32), o2drop: latest.o2_drop || \"3%\" };\n    }\n    case \"antioxidant\": {\n      const val = parseFloat(latest.carotenoid || latest.antioxidant || latest.value || 42);\n      return { value: val, unit: \"μmol/L\", range: { low: 20, high: 60 }, status: val > 35 ? \"Good\" : val > 20 ? \"Fair\" : \"Low\" };\n    }\n    case \"energyScore\": {\n      const val = parseFloat(latest.energy_score || latest.energy || latest.value || 84);\n      return { value: val, label: val >= 80 ? \"Excellent\" : val >= 65 ? \"Good\" : val >= 45 ? \"Fair\" : \"Poor\", breakdown: { sleep: parseFloat(latest.sleep_score || 88), hrv: parseFloat(latest.hrv_score || 79), activity: parseFloat(latest.activity_score || 85) } };\n    }\n    case \"fallDetection\": {\n      const incidents = parseInt(latest.fall_count || latest.incidents || 0);\n      return { incidents, status: incidents === 0 ? \"Clear\" : \"Alert\", lastCheck: latest.last_check || \"Today\", note: incidents === 0 ? \"No incidents in last 30 days.\" : `${incidents} incident(s) detected.` };\n    }\n    default: return null;\n  }\n}\n\nfunction calcTrend(rows, key) {\n  if (rows.length < 2) return \"Stable\";\n  const recent = parseFloat(rows[rows.length - 1][key] || 0);\n  const prev = parseFloat(rows[rows.length - 2][key] || 0);\n  if (!prev) return \"Stable\";\n  const pct = Math.round(((recent - prev) / prev) * 100);\n  return pct > 0 ? `+${pct}% vs prev` : pct < 0 ? `${pct}% vs prev` : \"Stable\";\n}\n\n// ═══════════════════════════════════════════════════════════════\n//  DEMO DATA (shown before CSV upload)\n// ═══════════════════════════════════════════════════════════════\n\nconst DEMO = {\n  steps:          { value: 11240, goal: 15000, unit: \"steps\", trend: \"+6% vs avg\", weekly: [8200, 11240, 7600, 13100, 9800, 6500, 10300] },\n  calories:       { value: 2810, goal: 3200, unit: \"kcal\", trend: \"−3% vs avg\", weekly: [2600, 2810, 2400, 3100, 2900, 2200, 2750] },\n  activeMinutes:  { value: 68, goal: 90, unit: \"min\", trend: \"+12 min vs avg\", weekly: [52, 71, 45, 90, 68, 33, 61] },\n  heartRate:      { resting: 58, max: 174, hrv: 62, unit: \"bpm\", trend: \"↓ 2 bpm vs last week\", weekly: [60, 58, 59, 57, 58, 61, 58] },\n  ecg:            { rhythm: \"Normal Sinus Rhythm\", rate: \"58 bpm\", qt: \"382 ms\", pr: \"156 ms\", qrs: \"88 ms\", notes: \"Athlete bradycardia noted. No abnormalities detected.\", tags: [\"NSR\", \"No abnorma
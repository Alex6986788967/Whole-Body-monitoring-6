// ══════════════════════════════════════════════
//  VIEW SWITCHING
// ══════════════════════════════════════════════
let activeSec = -1;

function showFull() {
  activeSec = -1;
  setActive(-1);
  renderCode(FULL, 1);
  document.getElementById('tl-fname').textContent = 'App.jsx';
  document.getElementById('crumb-file').textContent = 'App.jsx';
  document.getElementById('crumb-range').textContent = 'lines 1–877';
  document.getElementById('sb-section').textContent = 'Full File · 877 lines';
  document.getElementById('btn-full').classList.add('act');
  tlog('ok', 'Loaded: vitaledge_galaxy.jsx (877 lines)');
  tlog('dim', 'Tip: click any section in the sidebar to jump to that part of the code');
  tprompt();
}

function showSec(i) {
  const s = SECS[i];
  if (!s) return;
  activeSec = i;
  setActive(i);
  renderCode(s.lines, s.start);
  const n = s.end - s.start + 1;
  const ic = SEC_ICON[s.name] || '';
  document.getElementById('tl-fname').textContent = `${ic} ${s.name}`;
  document.getElementById('crumb-file').textContent = `App.jsx:${s.start}`;
  document.getElementById('crumb-range').textContent = `lines ${s.start}–${s.end}`;
  document.getElementById('sb-section').textContent = `${s.name} · ${n} lines`;
  document.getElementById('btn-full').classList.remove('act');
  tlog('ok', `Section: ${s.name}  (lines ${s.start}–${s.end}, ${n} lines)`);
  tprompt();
}

function setActive(i) {
  document.querySelectorAll('.etab').forEach(el => el.classList.remove('active'));
  document.querySelectorAll('.sb-row').forEach(el => el.classList.remove('active'));
  const tid = document.getElementById(`tab-${i}`);
  const sid = document.getElementById(`sb-${i}`);
  if (tid) tid.classList.add('active');
  if (sid) sid.classList.add('active');
}

// ══════════════════════════════════════════════
//  COPY
// ══════════════════════════════════════════════
function copyAll() {
  const text = activeSec >= 0 ? SECS[activeSec].lines : FULL;
  navigator.clipboard.writeText(text).then(() => {
    const t = document.getElementById('toast');
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 2000);
    const lines = text.split('\n').length;
    tlog('ok', `Copied ${lines} lines to clipboard`);
    tprompt();
  });
}

// click line number → highlight
document.getElementById('lnums').addEventListener('click', function(e) {
  const ln = e.target.dataset.ln;
  if (!ln) return;
  document.querySelectorAll('.lnums span').forEach(el => el.classList.remove('hl'));
  e.target.classList.add('hl');
  document.getElementById('sb-cursor').textContent = `Ln ${ln}, Col 1`;
});


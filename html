async function runCmd(name) {
  if (tbusy) return;
  const script = CMDS[name];
  if (!script) return;
  tbusy = true;
  // remove cursor
  const old = document.getElementById('tscroll').querySelector('.cursor-row');
  if (old) old.remove();
  for (const [type, text] of script) {
    tlog(type, text);
    await new Promise(r => setTimeout(r, type === 'cmd' ? 80 : 50 + Math.random()*70));
  }
  tbusy = false;
  tprompt();
}

function clearTerm() {
  document.getElementById('tscroll').innerHTML = '';
  tbusy = false;
  tlog('dim', 'Terminal cleared.');
  tprompt();
}


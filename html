let tbusy = false;

function tlog(type, text) {
  const body = document.getElementById('tscroll');
  const row = document.createElement('div');
  row.className = 'trow';
  if (type === 'cmd') {
    row.innerHTML = `<span class="tp">vitaledge:~$</span><span class="tc"> ${text}</span>`;
  } else {
    const cls = {ok:'ok',warn:'warn',err:'err',dim:'dim'}[type]||'';
    row.innerHTML = `<span class="to ${cls}">${text}</span>`;
  }
  body.appendChild(row);
  body.scrollTop = body.scrollHeight;
}

function tprompt() {
  const body = document.getElementById('tscroll');
  // remove old cursor row
  const old = body.querySelector('.cursor-row');
  if (old) old.remove();
  const row = document.createElement('div');
  row.className = 'trow cursor-row';
  row.innerHTML = `<span class="tp">vitaledge:~$</span><span class="cursor"></span>`;
  body.appendChild(row);
  body.scrollTop = body.scrollHeight;
}


// ══════════════════════════════════════════════
//  SYNTAX HIGHLIGHTER
// ══════════════════════════════════════════════
function hl(raw) {
  // 1. escape HTML
  let c = raw.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');

  // 2. protect box-drawing comment lines first (section headers)
  const BOX = /^([ \t]*\/\/[ \t]*[═╔╗╚╝║─┌┐└┘├┤┬┴┼]+.*)$/gm;
  c = c.replace(BOX, m => `\x01CM${btoa(unescape(encodeURIComponent(m)))}\x02`);

  // 3. normal line comments
  c = c.replace(/(\/\/[^\n\x01]*)/g, m => `\x01CM${btoa(unescape(encodeURIComponent(m)))}\x02`);

  // 4. template literals  `...`
  c = c.replace(/(`(?:[^`\\]|\\.)*`)/gs, m => `\x01SB${btoa(unescape(encodeURIComponent(m)))}\x02`);

  // 5. regular strings
  c = c.replace(/("(?:[^"\\]|\\.)*"|'(?:[^'\\]|\\.)*')/g, m => `\x01SB${btoa(unescape(encodeURIComponent(m)))}\x02`);

  // 6. keywords
  c = c.replace(/\b(import|export|default|from|const|let|var|function|return|if|else|switch|case|break|for|of|in|while|new|class|extends|async|await|typeof|null|undefined|true|false|try|catch|finally|throw)\b/g,
    '<span class="k">$1</span>');

  // 7. React hooks
  c = c.replace(/\b(useState|useCallback|useRef|useEffect|useReducer|useMemo)\b/g,
    '<span class="fn">$1</span>');

  // 8. numbers (not inside words)
  c = c.replace(/(?<![a-zA-Z_$#])(\d+\.?\d*)(?![a-zA-Z_$])/g,
    '<span class="n">$1</span>');

  // 9. JSX component names  <Foo  </Foo
  c = c.replace(/(&lt;\/?)([ ]*)([A-Z][a-zA-Z0-9]*)/g,
    (m, slash, sp, name) => `${slash}${sp}<span class="jt">${name}</span>`);

  // 10. arrow =>
  c = c.replace(/(=&gt;)/g, '<span class="op">$1</span>');

  // 11. restore protected tokens
  c = c.replace(/\x01CM([A-Za-z0-9+/=]*)\x02/g, (_, b64) => {
    try { return '<span class="cm">' + decodeURIComponent(escape(atob(b64))) + '</span>'; }
    catch { return '<span class="cm">' + b64 + '</span>'; }
  });
  c = c.replace(/\x01SB([A-Za-z0-9+/=]*)\x02/g, (_, b64) => {
    try { return '<span class="s">' + decodeURIComponent(escape(atob(b64))) + '</span>'; }
    catch { return '<span class="s">' + b64 + '</span>'; }
  });

  return c;
}

// ══════════════════════════════════════════════
//  RENDER CODE
// ══════════════════════════════════════════════
function renderCode(code, startLine) {
  const lines = code.split('\n');
  const n = lines.length;

  // highlighted code
  document.getElementById('cblock').innerHTML = hl(code);

  // line numbers
  let lhtml = '';
  for (let i = 0; i < n; i++) {
    const ln = startLine + i;
    lhtml += `<span id="ln${ln}" data-ln="${ln}">${ln}</span>`;
  }
  document.getElementById('lnums').innerHTML = lhtml;

  // minimap
  renderMinimap(lines);

  // status
  document.getElementById('sb-lines').textContent = n + ' lines';
  document.getElementById('cscroll').scrollTop = 0;
  onScroll();
}

// ══════════════════════════════════════════════
//  MINIMAP
// ══════════════════════════════════════════════
function renderMinimap(lines) {
  const step = Math.max(1, Math.floor(lines.length / 80));
  let html = '';
  for (let i = 0; i < lines.length; i += step) {
    const l = lines[i].trim();
    const cls = l.startsWith('//') ? 'cm' :
                /^(import|export|function|const|let|var|return|class)\b/.test(l) ? 'k' :
                /^[A-Z]/.test(l) ? 'fn' :
                l.startsWith('"') || l.startsWith("'") || l.startsWith('`') ? 's' : '';
    const w = Math.min(66, Math.round(l.length * 0.55));
    html += `<div class="mml ${cls}" style="width:${w}px"></div>`;
  }
  document.getElementById('mmcanvas').innerHTML = html;
  onScroll();
}

function onScroll() {
  const cs = document.getElementById('cscroll');
  const mm = document.getElementById('mmap');
  const mmvp = document.getElementById('mmvp');
  if (!cs.scrollHeight || !mm.clientHeight) return;
  const ratio = cs.scrollTop / Math.max(1, cs.scrollHeight - cs.clientHeight);
  const vpH = Math.max(16, (cs.clientHeight / cs.scrollHeight) * mm.clientHeight);
  const vpT = ratio * (mm.clientHeight - vpH);
  mmvp.style.top = vpT + 'px';
  mmvp.style.height = vpH + 'px';
}

function mmapClick(e) {
  const mm = document.getElementById('mmap');
  const cs = document.getElementById('cscroll');
  const ratio = e.offsetY / mm.clientHeight;
  cs.scrollTop = ratio * (cs.scrollHeight - cs.clientHeight);
}

